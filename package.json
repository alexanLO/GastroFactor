    "@angular/platform-server": "^21.2.13",
    "@angular/router": "^21.2.13",
    "@angular/ssr": "^21.2.11",
    "express": "^5.1.0",
    "glob": "^13.0.6",
    "ngx-logger": "^5.0.12",
    "normalize.css": "^8.0.1",
